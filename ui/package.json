{
  "name": "@apitomy/flow-ui",
  "version": "2.0.4-SNAPSHOT",
  "description": "Reusable React component for visual workflow editing and instance viewing",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Apitomy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apitomy/apitomy-flow.git",
    "directory": "ui"
  },
  "homepage": "https://github.com/Apitomy/apitomy-flow#readme",
  "bugs": {
    "url": "https://github.com/Apitomy/apitomy-flow/issues"
  },
  "keywords": [
    "workflow",
    "flow",
    "editor",
    "react",
    "component",
    "apitomy",
    "visual-editor"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "lint": "eslint src/ browser/*.ts browser/*.tsx browser/consumer/main.tsx playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:browser": "tsc -p browser/tsconfig.json --noEmit",
    "prepare:consumer": "node browser/prepare-consumer.mjs",
    "test:browser": "npm run prepare:consumer && npm run typecheck:browser && playwright test"
  },
  "peerDependencies": {
    "@patternfly/patternfly": "^6.0.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@monaco-editor/react": "4.7.0",
    "@patternfly/patternfly": "6.6.1",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "6.6.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "html-to-image": "1.11.13"
  }
}
